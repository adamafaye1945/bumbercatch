POSTGRES_DB=bumbercatch
POSTGRES_USER=bumbercatch
POSTGRES_PASSWORD=bumbercatch_dev_password
POSTGRES_PORT=5433

# Consumed by backend/src/db.ts
DATABASE_URL=postgres://bumbercatch:bumbercatch_dev_password@localhost:5433/bumbercatch

# Consumed by backend/src/icloud/sync.ts -- your iCloud email address and an
# app-specific password generated at appleid.apple.com (requires 2FA enabled
# on the Apple ID). Never use your real Apple ID password here.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Consumed by backend/src/services/weather.service.ts -- an OpenWeather API
# key (openweathermap.org/api) and your home's coordinates (decimal degrees;
# search "[your city] coordinates" or use openweathermap.org/find). Note:
# OpenWeather sometimes requires a separate (still free) "subscribe" click on
# their site for One Call API 3.0 before a fresh key works -- a 401 in the
# logs almost always means that step is missing.
OPEN_WEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=

# Consumed by backend/src/services/r6.service.ts -- an r6data.com (Arenyze)
# API key, and the roster of gamertags to track on the leaderboard. This env
# var is the source of truth for the roster: on every sync, gamertags here
# get added to the DB and any removed from here get deleted from the DB.
# R6_PLATFORM applies to the whole roster (uplay/psn/xbl).
R6_API_KEY=
R6_PLAYERS=
R6_PLATFORM=uplay
