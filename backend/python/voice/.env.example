API_BASE_URL=http://localhost:4000/api

# Path to the trained "Hey Bumbercatch" model (see the training-notebook step
# in the project plan). Until you've trained it, leave unset -- the daemon
# falls back to openWakeWord's bundled "hey_jarvis" model so it's runnable
# and testable in the meantime.
WAKEWORD_MODEL_PATH=

# Substring match (case-insensitive) against the input device name, e.g. "Soup"
# or "AirPods". Leave blank to use the system's default input device.
INPUT_DEVICE_NAME=
